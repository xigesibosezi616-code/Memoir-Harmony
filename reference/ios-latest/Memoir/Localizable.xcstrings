        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces carnets de la sauvegarde portent le même nom que des carnets de cet appareil : %@. S'ils sont importés comme nouveaux, un numéro sera ajouté à leur nom."
