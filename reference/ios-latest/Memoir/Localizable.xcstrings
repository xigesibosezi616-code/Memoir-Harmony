    "孤独不是坏事，是和自己独处的时间" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Solitude isn't bad — it's time alone with yourself.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«La soledad no es mala: es tiempo contigo.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« La solitude n'est pas un mal : c'est du temps avec soi. »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「孤独は悪くない。自分と過ごす時間だ」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“고독은 나쁜 것이 아니라, 자신과 함께 있는 시간이다”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「孤独不是坏事，是和自己独处的时间」"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「孤獨不是壞事，是和自己獨處的時間」"
          }
        }
      }
    },
