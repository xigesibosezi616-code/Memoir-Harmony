    "有些事想不通没关系，先写下来再说" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“It's fine not to understand yet. Write it down first.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«No pasa nada si aún no lo entiendes: escríbelo primero.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ce n'est pas grave de ne pas comprendre : écris d'abord. »"
          }
