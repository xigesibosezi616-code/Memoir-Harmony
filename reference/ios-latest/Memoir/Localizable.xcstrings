            "state" : "translated",
            "value" : "“No step is wasted. Every one counts.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ningún paso se pierde: todos cuentan.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Aucun pas n'est perdu : chacun compte. »"
