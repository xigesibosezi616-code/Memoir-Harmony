    "请先登录，笔友才能给你写信" : {
      "comment" : "AI 错误",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in first so your pen pal can write to you"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para que tu amigo por correspondencia pueda escribirte"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour que votre correspondant puisse vous écrire"
          }
        },
