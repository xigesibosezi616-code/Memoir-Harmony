    "慢慢来，好的东西值得等" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Take your time. Good things are worth waiting for.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ve despacio: lo bueno merece la espera.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Prends ton temps : ce qui est bon vaut qu'on l'attende. »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ゆっくりでいい。いいものは待つ価値がある」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“천천히 하세요. 좋은 것은 기다릴 만한 가치가 있으니까”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「慢慢来，好的东西值得等」"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「慢慢來，好的东西值得等」"
          }
        }
      }
    },
