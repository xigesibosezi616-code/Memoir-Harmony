        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「日子是一天天过的，也是一天天写的」"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「日子是一天天過的，也是一天天寫的」"
          }
        }
      }
