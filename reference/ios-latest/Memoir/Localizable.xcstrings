    "落笔的瞬间，时间就被你留住了" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The moment your pen touches down, time stays put.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«En el instante en que escribes, el tiempo se detiene.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« À l'instant où la plume se pose, le temps s'arrête. »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「筆を下ろした瞬間、時間はそこに留まる」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“펜을 대는 순간, 시간은 당신에게 붙잡힙니다”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
