    "时间不会等你，但文字会" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Time won't wait for you. Words will.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«El tiempo no te espera. Las palabras sí.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Le temps ne t'attend pas. Les mots, si. »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「時間は待ってくれない。でも言葉は待ってくれる」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“시간은 기다려 주지 않지만, 글은 기다려 줍니다”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「时间不会等你，但文字会」"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「時間不會等你，但文字會」"
          }
        }
      }
    },
