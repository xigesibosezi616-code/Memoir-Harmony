    "所有不被记住的日子，都不算活过" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Days that go unremembered were never really lived.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Los días que no se recuerdan no se han vivido.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Les jours dont on ne se souvient pas n'ont pas été vécus. »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「覚えていない日々は、生きたことにならない」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“기억되지 않은 날들은, 살았다고 할 수 없다”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「所有不被记住的日子，都不算活过」"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「所有不被記住的日子，都不算活過」"
          }
        }
      }
    },
    "所有的等待，都是在等一个更好的自己" : {
      "extractionState" : "manual",
