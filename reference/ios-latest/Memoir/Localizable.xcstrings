        }
      }
    },
    "平凡的一天，也藏着不平凡的感受" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Even an ordinary day holds something out of the ordinary.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Incluso un día corriente guarda algo extraordinario.»"
          }
