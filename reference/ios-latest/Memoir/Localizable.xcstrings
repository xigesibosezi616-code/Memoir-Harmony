    "情绪没有对错，只有被听见和被忽略的区别" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Feelings aren't right or wrong — only heard or ignored.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Las emociones no son buenas ni malas: solo escuchadas o ignoradas.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Les émotions ne sont ni justes ni fausses : elles sont entendues, ou ignorées. »"
