            "value" : "光がちょうどいい。今の気持ちを書き留めるのに"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "햇살이 좋네요. 지금의 기분을 남기기에 좋은 날이에요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日光正好，适合记录此刻的心情"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日光正好，適合記錄此刻的心情"
          }
        }
      }
    },
    "日子是一天天过的，也是一天天写的" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Days are lived one at a time, and written the same way.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Los días se viven uno a uno, y así se escriben.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Les jours se vivent un à un, et s'écrivent de même. »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「日々は一日ずつ過ぎ、一日ずつ書かれてゆく」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“하루하루 살아가듯, 하루하루 써 내려갑니다”"
