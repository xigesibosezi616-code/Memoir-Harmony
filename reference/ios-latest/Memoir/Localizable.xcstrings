    "偶尔停下来，看看走过的路" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Stop now and then and look at how far you've come.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Detente de vez en cuando y mira el camino recorrido.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Arrête-toi parfois pour regarder le chemin parcouru. »"
          }
