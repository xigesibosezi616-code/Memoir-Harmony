    "此刻只有你和你的心事" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right now it's just you and what's on your mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora solo estáis tú y lo que llevas dentro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À cet instant, il n'y a que toi et ce qui t'habite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまはあなたと、あなたの想いだけ"
