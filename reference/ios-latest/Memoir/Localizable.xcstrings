        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「有些事想不通沒關系，先寫下來再說」"
          }
        }
      }
    },
    "有些话说不出口，写下来就好" : {
      "extractionState" : "manual",
