    "四季更替，你的故事也是" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The seasons turn. So does your story.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Las estaciones cambian. Tu historia también.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Les saisons tournent. Ton histoire aussi. »"
          }
        },
        "ja" : {
