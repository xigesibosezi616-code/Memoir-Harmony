/**
 * 二级页定格顶栏（返回圆钮 + 居中标题）的统一量测。
 *
 * 所有二级页共用这一份数据，改这里即全局生效：
 * - 顶栏行高 44vp；
 * - 顶栏与页面首个内容块之间统一留 16vp 间距
 *   （用户 2026-11-07 反馈：功能块距返回按键和上面的标题太近，统一下移）。
 */

/** 顶栏一行的高（返回圆钮 + 居中标题） */
export const TOP_BAR_ROW_HEIGHT_VP: number = 44;

/** 顶栏与页面首个内容块之间的统一间距 */
export const TOP_BAR_CONTENT_GAP_VP: number = 16;
